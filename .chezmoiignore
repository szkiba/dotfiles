install.sh
test-prompt.sh

# Docker Sandboxes config, only where sbx is installed
{{ if not (lookPath "sbx") -}}
.sbxenv.yaml
.config/sandboxes
{{ end -}}

# nono profiles, only where nono is installed
{{ if not (lookPath "nono") -}}
.config/nono
.local/wrappers/nono
{{ end -}}

# Agent sandbox settings, only where the agent is installed
{{ if not (lookPath "claude") -}}
.claude/settings.json
{{ end -}}
{{ if not (lookPath "codex") -}}
.codex/config.toml
{{ end -}}
{{ if not (lookPath "copilot") -}}
.copilot/settings.json
.local/wrappers/copilot
{{ end -}}

# SSH private key material — never manage in dotfiles
.ssh/id_*
.ssh/*_rsa
.ssh/*_ed25519
.ssh/*_ecdsa
.ssh/*.key
!.ssh/*.pub

# machine-specific + leaks hosts you've connected to
.ssh/known_hosts
.ssh/known_hosts.old
