{
  "extends": "claude",
  "meta": {
    "name": "kaizen",
    "description": "Claude Code for the kaizen skill under nono: read-only view of the agent transcripts, the sandbox archive and the publish log, plus the chezmoi source to edit and ~/knowledge to write, and a GitHub token from 1Password for git over https"
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "read": [
      "$HOME/.local/state/agent-archive",
      "$HOME/.local/state/github-publish",
      "$HOME/.codex/sessions",
      "/hub/synthetic"
    ],
    "allow": [
      "$HOME/.config/chezmoi",
      "$HOME/knowledge"
    ]
  },
  "env_credentials": {
    "op://GitHub/cli/token": "GH_TOKEN"
  },
  "environment": {
    "set_vars": {
      "GIT_CONFIG_COUNT": "2",
      "GIT_CONFIG_KEY_0": "credential.https://github.com.helper",
      "GIT_CONFIG_VALUE_0": "",
      "GIT_CONFIG_KEY_1": "credential.https://github.com.helper",
      "GIT_CONFIG_VALUE_1": "!/home/linuxbrew/.linuxbrew/bin/gh auth git-credential"
    }
  }
}
