{
  "extends": "claude",
  "meta": {
    "name": "kaizen",
    "description": "Claude Code for the kaizen skill under nono: read-only view of the agent transcripts, the sandbox archive and the publish log, plus the chezmoi source to edit and ~/knowledge to write, and git over https to github.com plus the GitHub API with write access, with the token from 1Password injected by the nono proxy so the sandbox only sees a placeholder"
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "read": [
      "$HOME/.local/state/agent-archive",
      "$HOME/.local/state/github-publish",
      "$HOME/.codex/sessions",
      "/hub/synthetic"
    ],
    "allow": [
      "$HOME/.config/chezmoi",
      "$HOME/knowledge"
    ]
  },
  "network": {
    "credentials": ["github", "github-api"],
    "custom_credentials": {
      "github": {
        "upstream": "https://github.com",
        "credential_key": "op://GitHub/szkiba/token",
        "env_var": "GH_TOKEN",
        "inject_mode": "basic_auth"
      },
      "github-api": {
        "upstream": "https://api.github.com",
        "credential_key": "op://GitHub/szkiba/token",
        "env_var": "GH_TOKEN",
        "inject_mode": "header",
        "inject_header": "Authorization",
        "credential_format": "token {}"
      }
    }
  },
  "environment": {
    "set_vars": {
      "GIT_CONFIG_COUNT": "2",
      "GIT_CONFIG_KEY_0": "credential.https://github.com.helper",
      "GIT_CONFIG_VALUE_0": "",
      "GIT_CONFIG_KEY_1": "credential.https://github.com.helper",
      "GIT_CONFIG_VALUE_1": "!/home/linuxbrew/.linuxbrew/bin/gh auth git-credential"
    }
  }
}
