[global_config]
  putty_paste_style = True
  disable_mouse_paste = True
[keybindings]
[profiles]
  [[default]]
    background_color = "#282828"
    cursor_fg_color = "#000000"
    cursor_bg_color = "#aaaaaa"
    cursor_color_default = False
    font = Ubuntu Sans Mono 16
    foreground_color = "#ebdbb2"
    show_titlebar = False
    use_system_font = False
    bold_is_bright = True
    copy_on_selection = True
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
      profile = default
[plugins]
