# chezmoi:template:left-delimiter="[["
# chezmoi:template:right-delimiter="]]"
schemaVersion: "1"

args:
  agent:
    default: "claude"
    enum:
      - claude
      - codex
      - shell
    description: "AI agent to use for the sandbox"
  cpus:
    default: "12"
    pattern: "[1-9][0-9]*"
    description: "Number of CPU cores for the sandbox"
  memory:
    default: "24g"
    pattern: "[1-9][0-9]*[gG]"
    description: "Amount of memory for the sandbox"

  owner:
    default: "grafana"
    enum:
      - grafana
      - [[ .github_user ]]
    description: "GitHub owner of the sandbox"

agent: ${{ env.args.agent }}

workspace:
  path: ${{ env.projectDir }}
  clone: false

additionalWorkspaces:
  - path: /home/agent/.ai
    readOnly: true
  - path: /home/agent/.claude/CLAUDE.md
    readOnly: true
  - path: /home/agent/.codex/AGENTS.md
    readOnly: true
  - path: /home/agent/.gitconfig
    readOnly: true
  - path: /home/agent/.config/git
    readOnly: true

sandboxOptions:
  cpus: ${{ env.args.cpus }}
  memory: ${{ env.args.memory }}

env:

# on a host once:
#
# Codex:
# sbx secret set openai --oauth
#

secrets:
  github:
    ref: op://GitHub/cli/token
