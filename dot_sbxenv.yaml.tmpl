# chezmoi:template:left-delimiter="[["
# chezmoi:template:right-delimiter="]]"
schemaVersion: "1"

args:
  cpus:
    default: "12"
    pattern: "[1-9][0-9]*"
    description: "Number of CPU cores for the sandbox"
  memory:
    default: "24g"
    pattern: "[1-9][0-9]*[gG]"
    description: "Amount of memory for the sandbox"

  owner:
    default: "grafana"
    enum:
      - grafana
      - [[ .github_user ]]
    description: "GitHub owner of the sandbox"

agent: sbx-kit-claude
kits:
  - docker.io/docker/sbx-kit-claude:latest
  - docker.io/docker/sbx-kit-codex-mixin:latest
  - [[ .chezmoi.homeDir ]]/.config/sandboxes/kits/global-agents
  - [[ .chezmoi.homeDir ]]/.config/sandboxes/kits/openspec
  - [[ .chezmoi.homeDir ]]/.config/sandboxes/kits/jj
  - [[ .chezmoi.homeDir ]]/.config/sandboxes/kits/ssh-agent

workspace:
  path: ${{ env.projectDir }}
  clone: true

additionalWorkspaces:
  - path: /home/agent/.ai
    readOnly: true
# A file mount under ~/.DIR makes that .DIR root-owned
#  - path: /home/agent/.codex/AGENTS.md
#    readOnly: true
#  - path: /home/agent/.claude/CLAUDE.md
#    readOnly: true
  - path: /home/agent/.gitconfig
    readOnly: true
  - path: /home/agent/.config/git
    readOnly: true
  - path: /hub/all
    readOnly: true
[[- if stat (joinPath .chezmoi.homeDir "knowledge") ]]
# notes saved from earlier sessions, only where ~/knowledge exists
  - path: /home/agent/knowledge
    readOnly: true
[[- end ]]
  - path: /home/agent/.config/jj/config.toml
    readOnly: true

sandboxOptions:
  cpus: ${{ env.args.cpus }}
  memory: ${{ env.args.memory }}

