#!/bin/sh
# Cleanup only. An earlier version set a Copilot status line that ran
# agent-isolation, and created settings.json to hold it. That script is gone, so
# this removes the status line, but only if it is that one, and leaves everything
# else Copilot saved. Delete this file once every machine has applied it.
#
# With no settings.json there is nothing to clean, so it prints nothing and
# chezmoi does not create the file.
if ! command -v jq >/dev/null 2>&1; then
  echo "modify settings.json: jq is required to clean up Copilot's status line" >&2
  exit 1
fi

in=$(cat)
[ -n "$in" ] || exit 0
printf '%s\n' "$in" | jq '
  if ((.statusLine.command? // "") | tostring | contains("agent-isolation")) then del(.statusLine) else . end
'
