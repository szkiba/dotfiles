# Enable the subsequent settings only in interactive sessions
case $- in
  *i*) ;;
    *) return;;
esac

# Inside a sandbox, start in the workspace directory.
if [ "$IS_SANDBOX" = 1 ] && [ -n "$WORKSPACE_DIR" ]; then
  cd "$WORKSPACE_DIR" || true
fi

# oh-my-bash setup (theme, completions, aliases, plugins).
. ~/.config/bash/osh.sh

export LS_COLORS="$LS_COLORS:*,v=2;30"

# Opt out of Homebrew's telemetry, then load its env (PATH, MANPATH, ...) if installed.
export HOMEBREW_NO_ANALYTICS=1
[[ -x /home/linuxbrew/.linuxbrew/bin/brew ]] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

# Auto-load/unload per-directory .envrc files, if direnv is installed.
if direnv --version >/dev/null 2>&1 ; then
  eval "$(direnv hook bash)"
fi

# Shell completions for jj (Jujutsu), if installed.
if command -v jj >/dev/null 2>&1 ; then
  source <(COMPLETE=bash jj)
fi

# Machine-local secrets, not tracked in dotfiles.
[ -r ~/.secrets.env ] && . ~/.secrets.env

# Detect and export $EDITOR.
. ~/.config/bash/editor.sh

# nono run/shell/wrap share the working directory without asking.
. ~/.config/bash/nono.sh

# moor for people, cat for agents (see safe-pager). git, man, delta and bat all read $PAGER.
export PAGER=$HOME/.local/bin/safe-pager

# Only set when the CloudBox sync has actually delivered the vault key.
if [ -f ~/Documents/CloudBox/keys/ansible-vault-password ]; then
  export ANSIBLE_VAULT_PASSWORD_FILE=$HOME/Documents/CloudBox/keys/ansible-vault-password
fi

[ -r ~/.config/op/plugins.sh ] && . ~/.config/op/plugins.sh

# Put ~/.local/wrappers first in PATH (after brew's shellenv, which also prepends),
# so wrappers apply to child processes too, such as agents and scripts. The gh
# wrapper there replaces the gh() function from plugins.sh, which would
# otherwise run the plugin twice.
_wrappers=$HOME/.local/wrappers
_p=":$PATH:"; _p=${_p//":$_wrappers:"/:}; PATH="$_wrappers${_p%:}"
unset -f gh
unset _wrappers _p

unalias c
