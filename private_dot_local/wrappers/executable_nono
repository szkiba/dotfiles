#!/usr/bin/env bash
# Two conveniences on top of nono. Put this folder first in PATH.
#
#   nono as <name> [agent args]
#     Run an agent in the nono profile of the same name. Everything after the name
#     goes to the agent. For extra nono flags use the long form,
#     nono run --profile <name> <flags> -- <agent>. The names live under "as" so
#     they can never shadow a real nono subcommand (nono has its own audit, for
#     one). Without a name it lists them.
#
#       claude, codex
#         That agent in its profile. Claude's and Codex's own sandboxes are turned
#         off there: nono is the boundary, and bubblewrap cannot run inside it.
#
#       kaizen
#         Claude Code in the kaizen profile, for the kaizen skill. It always
#         starts in the chezmoi source folder, which is shared read-write, with
#         read access to the transcripts, the sandbox archive and the publish log
#         plus write access to ~/.ai and the chezmoi state, so
#         `chezmoi apply ~/.ai` works. Apply with that path: a full apply would run
#         the sbx skill import, which cannot work in nono, and chezmoi would then
#         count it as done. Only this shortcut allows `chezmoi apply` and
#         `git worktree add|remove|prune` without a permission prompt, and the
#         EnterWorktree and ExitWorktree tools. The skill still says to apply only
#         when you ask.
#
#     Every profile can sign commits through your ssh agents and read the public
#     part of the TPM key. To commit as the machine identity instead of yours, start
#     it with GIT_CONFIG_GLOBAL=~/.gitconfig-machine in the environment.
#
#   nono run|shell|wrap ...
#     Pass --allow-cwd so the working directory is shared without the prompt.
#
# The shortcuts and run|shell|wrap refuse, with a short message, to share a
# folder that holds your home directory (see refuse_home).

# Drop this folder from PATH, or `exec nono` would find this wrapper again and
# loop.
self=$(cd "${0%/*}" && pwd)
p=":$PATH:"; p=${p//":$self:"/:}; p=${p#:}
PATH=${p%:}

# --allow-cwd only in a terminal. Without one (scripts, agents, CI) keep nono's
# own rule: it wants an explicit --allow-cwd there. The access level still
# comes from the profile (workdir.access).
cwd=()
share=
if [ -t 0 ] && [ -t 1 ]; then
  cwd=(--allow-cwd)
  share=1
fi
# nono rejects the flag twice, so leave it out if it was typed already.
for a in "$@"; do
  [ "$a" = -- ] && break
  if [ "$a" = --allow-cwd ]; then
    cwd=()
    share=1
  fi
done

# nono shares the working folder with the agent. If that folder holds your home
# directory (~ itself, or /home, or /), sharing it would cover ~/.ssh, ~/.aws
# and the other protected paths, and nono refuses with a very long error. Say it
# in two lines instead.
refuse_home() {
  [ -n "$share" ] || return 0
  local here home
  here=$(pwd -P)
  home=$(cd "$HOME" 2>/dev/null && pwd -P) || return 0
  if [ "$here" = / ] || [[ "$home/" == "$here"/* ]]; then
    echo "nono: $here holds your home directory, so sharing it would expose ~/.ssh, ~/.aws and other protected paths." >&2
    echo "nono: start it from a project folder instead." >&2
    exit 1
  fi
}

case $1 in
  claude|codex|kaizen)
    # The old spelling. These names are not nono subcommands, so say where they went.
    echo "nono: use \"nono as $1\"" >&2
    exit 1
    ;;
  as)
    shift
    case ${1:-} in
      claude|codex|kaizen) ;;
      *)
        [ -z "${1:-}" ] || echo "nono as: unknown name $1" >&2
        echo "usage: nono as <name> [agent args]" >&2
        echo "  claude, codex            that agent in its nono profile" >&2
        echo "  kaizen                   Claude Code to improve the rules, in the chezmoi source" >&2
        [ -z "${1:-}" ] && exit 0
        exit 1
        ;;
    esac
    agent=$1
    profile=$1
    shift
    # kaizen is Claude Code with a profile of its own.
    case $agent in kaizen) agent=claude ;; esac
    # A sandbox cannot start inside another one.
    if [ -n "${NONO_CAP_FILE:-}" ]; then
      echo "nono: already inside a nono sandbox, run $agent directly" >&2
      exit 1
    fi
    # Claude's native sandbox is on in settings.json and bubblewrap cannot run
    # inside nono, so turn it off for this run. --settings beats the user file.
    # The kaizen run also gets permission rules, in this --settings only, so no
    # other session is affected.
    if [ "$agent" = claude ]; then
      settings='{"sandbox":{"enabled":false}}'
      if [ "$profile" = kaizen ]; then
        settings='{"sandbox":{"enabled":false},"permissions":{"allow":["Bash(chezmoi apply:*)","Bash(git worktree add:*)","Bash(git worktree remove:*)","Bash(git worktree prune:*)","EnterWorktree","ExitWorktree"]}}'
      fi
      set -- --settings "$settings" "$@"
    fi
    # kaizen edits the chezmoi source, so it starts there whatever the folder.
    if [ "$profile" = kaizen ]; then
      src=$(chezmoi source-path 2>/dev/null) || src=$HOME/.local/share/chezmoi
      cd "$src" 2>/dev/null || { echo "nono: cannot enter the chezmoi source folder $src" >&2; exit 1; }
    fi
    # Codex has its own sandbox, which clashes with nono's, so turn it off and
    # let nono be the boundary. --no-daemon keeps codex from using the shared
    # background server, which runs outside nono. Approvals stay on. Codex
    # rejects a repeated flag, so each default is added only if it was not
    # given.
    if [ "$agent" = codex ]; then
      have_daemon= have_sandbox= have_approval=
      for a in "$@"; do
        case $a in
          --no-daemon) have_daemon=1 ;;
          -s|--sandbox|--sandbox=*) have_sandbox=1 ;;
          -a|--ask-for-approval|--ask-for-approval=*) have_approval=1 ;;
        esac
      done
      defaults=()
      [ -n "$have_daemon" ] || defaults+=(--no-daemon)
      [ -n "$have_sandbox" ] || defaults+=(--sandbox danger-full-access)
      [ -n "$have_approval" ] || defaults+=(--ask-for-approval on-request)
      set -- "${defaults[@]}" "$@"
    fi
    refuse_home
    exec nono run "${cwd[@]}" --profile "$profile" -- "$agent" "$@"
    ;;
  run|shell|wrap)
    sub=$1
    shift
    # nono's own -h/--help needs no folder, so let it through.
    for a in "$@"; do
      [ "$a" = -- ] && break
      case $a in -h|--help) share= ;; esac
    done
    refuse_home
    exec nono "$sub" "${cwd[@]}" "$@"
    ;;
esac

exec nono "$@"
