#!/usr/bin/env bash
# Run gh through the 1Password shell plugin. The gh() function from
# ~/.config/op/plugins.sh only exists in interactive shells, so agents and
# scripts would otherwise call the real gh. Put this folder first in PATH.

# Drop this folder from PATH, or `op plugin run -- gh` would find this
# wrapper again instead of the real gh and loop.
self=$(cd "${0%/*}" && pwd)
p=":$PATH:"; p=${p//":$self:"/:}; p=${p#:}
PATH=${p%:}

# gh starts a pager when stdout is a terminal, which hangs agents and scripts
# that run in a pty and wait for a "q". Set GH_PAGER yourself to override.
export GH_PAGER=${GH_PAGER:-cat}

# Without 1Password (for example inside a sandbox) just run the real gh.
if ! command -v op >/dev/null 2>&1; then
  exec gh "$@"
fi

exec op plugin run -- gh "$@"
