{{/*
Git SSH signing configuration:
1. Trust keys from ~/.config/git/allowed_signers.
2. Select the signing key at sign time via gpg.ssh.defaultKeyCommand.
3. The selector returns the first key listed in allowed_signers that is
   currently loaded in ssh-agent.

This keeps allowed_signers as the source of truth for both trust and key
priority, and avoids storing a stale user.signingkey in ~/.gitconfig.
*/}}


[user]
	email = szkiba@users.noreply.github.com
	name = Iván SZKIBA

[core]
	quotepath = false
	excludesfile = ~/.config/git/ignore
{{- if lookPath "delta" }}
	pager = delta
{{- end }}

[init]
	defaultBranch = main

{{- if lookPath "gh" }}
# Credential helpers
{{ if and (lookPath "op") (output "sh" "-c" "op plugin list 2>/dev/null | grep -q '^gh\\s' && echo yes || true" | trim | eq "yes") -}}

[credential "https://github.com"]
	helper = !op plugin run -- gh auth git-credential

[credential "https://gist.github.com"]
	helper = !op plugin run -- gh auth git-credential
{{- else }}
[credential "https://github.com"]
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper = !gh auth git-credential
{{- end }}

# Rewrite SSH to HTTPS for repositories
[url "https://github.com/"]
	insteadOf = git@github.com:
	insteadOf = ssh://git@github.com/

# Rewrite SSH to HTTPS for Gists
[url "https://gist.github.com/"]
	insteadOf = git@gist.github.com:
	insteadOf = ssh://git@gist.github.com/
{{- else }}

# Rewrite HTTPS to SSH for repositories
[url "git@github.com:"]
	insteadOf = https://github.com/

# Rewrite HTTPS to SSH for Gists
[url "git@gist.github.com:"]
	insteadOf = https://gist.github.com/
{{- end }}

[gpg]
	format = ssh

[commit]
	gpgsign = true

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
	defaultKeyCommand = {{ .chezmoi.homeDir }}/.config/git/signing-key-command

{{ if lookPath "delta" -}}
[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true

[merge]
	conflictStyle = zdiff3
{{- end }}
